# OpenAI API key (required) — https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Java spatial service URL (required)
# The Python app fetches the OpenAPI spec from <JAVA_SPATIAL_API_URL>/api-docs
# and proxies spatial queries to <JAVA_SPATIAL_API_URL>/api/v1/taxis/...
JAVA_SPATIAL_API_URL=http://localhost:8080

# gov-data Java backend URL (required for traffic camera chat)
# Provides camera snapshots and metadata via /api/cameras/...
GOV_DATA_API_URL=http://localhost:8080

JAVA_BACKEND_API_URL=http://localhost:8080

# Optional: LangSmith tracing — https://smith.langchain.com/
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key-here
# LANGCHAIN_PROJECT=civic-app

# Optional: log verbosity (DEBUG | INFO | WARNING | ERROR)
# LOG_LEVEL=INFO
