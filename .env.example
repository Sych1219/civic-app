# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# API Base URL for triggering Singapore government data endpoints
# Replace with the actual base URL of your trigger API
API_BASE_URL=https://api.example.com

# Optional: LangSmith Configuration (for tracing and monitoring)
# Get your API key from: https://smith.langchain.com/
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key-here
# LANGCHAIN_PROJECT=civic-app

# Optional: Custom OpenAI Configuration
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_ORGANIZATION=your-org-id

# Optional: Set log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
